{
  "name": "voidrift-desktop",
  "version": "0.1.0",
  "description": "VoidRift Desktop — a standalone cross-platform chat application: an Electron thin client embedding @voidrift/core in the main process, with a hardened renderer reaching the SDK only through a two-primitive allow-listed contextBridge (desktop-blueprint.md).",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "coverage": "vitest --run --coverage",
    "lint": "eslint src"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.0",
    "@voidrift/core": "^0.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@langchain/core": "1.2.17",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "typescript-eslint": "8.71.1"
  },
  "voidrift": {
    "kind": "product"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TylerJPresley/voidrift-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/TylerJPresley/voidrift-desktop/issues"
  },
  "homepage": "https://github.com/TylerJPresley/voidrift-desktop#readme",
  "keywords": [
    "voidrift",
    "desktop",
    "standalone",
    "cross",
    "platform"
  ],
  "files": [
    "dist",
    "LICENSE"
  ]
}
